#!/usr/bin/env bash
#
# Check the syntax of every PHP file of the project with the PHP that runs this script.
# CI runs it on the oldest and the newest supported PHP.

set -uo pipefail

cd "$(dirname "$0")/.."

list="$(mktemp)"
trap 'rm -f "$list"' EXIT

find . -name '*.php' \
	-not -path './vendor/*' \
	-not -path './.git/*' \
	-not -path './.cache/*' \
	-not -path './.claude/*' \
	-not -path './.conductor/*' \
	-print0 >"$list"

count="$(tr -cd '\0' <"$list" | wc -c | tr -d ' ')"

# Four at a time. A file that fails is checked again so its error is shown.
if ! xargs -0 -n 16 -P 4 sh -c '
	status=0
	for file in "$@"; do
		if ! php -n -l "$file" >/dev/null 2>&1; then
			php -n -d display_errors=1 -l "$file" >&2
			status=1
		fi
	done
	exit "$status"
' sh <"$list"; then
	exit 1
fi

echo "PHP $(php -r 'echo PHP_VERSION;'): no syntax errors in $count files."
