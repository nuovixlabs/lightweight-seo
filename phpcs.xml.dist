<?xml version="1.0"?>
<ruleset name="Lightweight SEO">
    <description>WordPress coding standards for the Lightweight SEO plugin.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>

    <file>lightweight-seo.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    <!-- A stand-in for WP-CLI: it has to declare WP-CLI's own class and namespaced function in one file. -->
    <exclude-pattern>tests/fixtures/wp-cli-stub.php</exclude-pattern>
    <!-- JavaScript tests run under Node and are not PHP. -->
    <exclude-pattern>tests/js/*</exclude-pattern>

    <!-- Shipped code and tests run on PHP 7.4 and later. WordPress polyfills are taken into account. -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress-Core">
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <exclude name="WordPress.Files.FileComment.MissingPackageTag"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
    </rule>

    <!-- Security and i18n gates for shipped code: escaping, nonces, input handling, and text domain. -->
    <rule ref="WordPress.Security">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.EnqueuedResources">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="text_domain" type="array">
                <element value="lightweight-seo"/>
            </property>
        </properties>
    </rule>
</ruleset>
